# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Password shared by the five demo logins (used by the seed script and tests)
DEMO_PASSWORD=
# Server-only. Signs AI plans before they are saved; the database holds the same value.
# Get it by running `select private.new_plan_signing_secret();` in the Supabase SQL editor.
PLAN_SIGNING_SECRET=
